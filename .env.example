# Copy to .env and adjust.
DATABASE_URL=postgres://pay:pay@localhost:5432/payments
PORT=3000
# Public base URL, used for provider callback/redirect URLs.
PUBLIC_URL=http://localhost:3000

# "sandbox" (no real money, built-in fake checkout) or "paystack".
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=change-me-sandbox-secret
# Delay before the sandbox provider "settles" a payout, in ms.
SANDBOX_PAYOUT_DELAY_MS=1500

# Paystack (South Africa). Use your sk_test_... key while testing.
PAYSTACK_SECRET_KEY=

# Bearer token for /admin endpoints (ledger reconciliation).
ADMIN_TOKEN=change-me-admin-token

# Fees in cents.
WITHDRAWAL_FEE_CENTS=500

# Secret used to hash SA ID numbers for duplicate detection.
KYC_PEPPER=change-me-kyc-pepper
